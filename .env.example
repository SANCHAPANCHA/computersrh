# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: canonical site URL used in share links (e.g. https://rhpclab.vercel.app)
NEXT_PUBLIC_SITE_URL=

# ── Live X feed (optional) ─────────────────────────────────────────────
# Without X_BEARER_TOKEN the news block falls back to X's free embedded timeline.
# With it, posts are mirrored into Supabase and styled like the rest of the lab.
# Server-only secrets: never prefix these with NEXT_PUBLIC_.
X_BEARER_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
# Account to mirror (default ComputersRh) and minimum seconds between X API polls (default 60)
X_FEED_USERNAME=
X_FEED_POLL_SECONDS=
