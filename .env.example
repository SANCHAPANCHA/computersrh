# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: canonical site URL used in share links (e.g. https://rhpclab.vercel.app)
NEXT_PUBLIC_SITE_URL=

# REQUIRED for the game (credits, shop, upgrades, roulette, battles) and the chat.
# Supabase → Settings → API → service_role. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Live X feed (optional) ─────────────────────────────────────────────
# Without X_BEARER_TOKEN, news comes from rows in the x_posts table (or X's embed).
X_BEARER_TOKEN=
# Account to mirror (default ComputersRh) and minimum seconds between X API polls (default 60)
X_FEED_USERNAME=
X_FEED_POLL_SECONDS=
